{
  "name": "stocktrail",
  "version": "0.0.0",
  "private": true,
  "description": "Local Shopify inventory diagnostics CLI",
  "type": "module",
  "bin": {
    "stocktrail": "dist/apps/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc",
    "build:dashboard": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dashboard.json",
    "dev": "npm run build --silent && node dist/apps/cli/src/index.js",
    "start": "node dist/apps/cli/src/index.js",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
